# Copy this file to .env and fill in your values

# ── Server ───────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — Atlas
MONGODB_URI=

# ── Client (Vite injects VITE_ prefixed vars) ─
# Set in client/.env if needed
# VITE_API_URL=http://localhost:5000

VITE_APP_NOTIFICATIONS_ENABLED=false
VITE_APP_RSVP_ENABLED=true
RSVP_OPEN=true