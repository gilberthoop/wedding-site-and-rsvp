# Copy this file to .env and fill in your values

# ── Server ───────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — local dev
MONGODB_URI=mongodb://localhost:27017/wedding-site

# MongoDB — Atlas (production)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/wedding-site?retryWrites=true&w=majority

# ── Client (Vite injects VITE_ prefixed vars) ─
# Set in client/.env if needed
# VITE_API_URL=http://localhost:5000

VITE_APP_NOTIFICATIONS_ENABLED=false
VITE_APP_RSVP_ENABLED=false